+	var h io.Writer
+	var sum func([]byte) []byte
+	switch algorithm {
+	case "md5":
+		m := md5.New()
+		h, sum = m, m.Sum
+	case "xxhash":
+		x := xxhash.New()
+		h, sum = x, x.Sum
+	case "highway":
+		key, err := hex.DecodeString("1553c5383fb0b86578c3310da665b4f6e0521acf22eb58a99532ffed02a6b115")
+		if err != nil {
