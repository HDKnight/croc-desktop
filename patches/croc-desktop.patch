+		hw, err := highwayhash.New(key)
+		if err != nil {
+			return nil, fmt.Errorf("could not create highwayhash: %w", err)
+		}
+		h, sum = hw, hw.Sum
+	default:
+		return nil, fmt.Errorf("unsupported algorithm: %s", algorithm)
+	}
+	fn(0, total)
