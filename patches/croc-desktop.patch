+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(sum, plain) {
+		t.Fatal("progress hash mismatch")
+	}
+	if calls < 2 || lastDone != int64(len(payload)) || lastTotal != int64(len(payload)) {
+		t.Fatalf("progress calls=%d done=%d total=%d", calls, lastDone, lastTotal)
 	}
 }
 
